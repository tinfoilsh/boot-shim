From 969575db83414abf48b41d01a2b7fd8671954f29 Mon Sep 17 00:00:00 2001
From: Joe Lothan <joe@tinfoil.sh>
Date: Thu, 27 Aug 2026 16:02:20 -0700
Subject: [PATCH] igvm: add Intel TDX as a supported IGVM platform

Upstream supports IGVM for SEV, SEV-ES and SEV-SNP but not TDX, so a TDX
guest cannot be launched from an IGVM file at all. Take the
confidential-guest-support from the context rather than the machine, hand
imported pages to the TDX module, and discard through
ram_block_discard_range().

Applies to qemu 10.1.0, tarball sha256
e0517349b50ca73ebec2fa85b06050d5c463ca65c738833bd8fc1f15f180be51.
---
 backends/igvm.c                             | 13 +++-
 include/system/confidential-guest-support.h |  1 +
 target/i386/kvm/tdx.c                       | 83 +++++++++++++++++++--
 3 files changed, 88 insertions(+), 9 deletions(-)

diff --git a/backends/igvm.c b/backends/igvm.c
index 9ad41582e..9e60b0ad0 100644
--- a/backends/igvm.c
+++ b/backends/igvm.c
@@ -763,6 +763,7 @@ static int qigvm_supported_platform_compat_mask(QIgvm *ctx, Error **errp)
     uint32_t compatibility_mask_sev = 0;
     uint32_t compatibility_mask_sev_es = 0;
     uint32_t compatibility_mask_sev_snp = 0;
+    uint32_t compatibility_mask_tdx = 0;
     uint32_t compatibility_mask = 0;
 
     header_count = igvm_header_count(ctx->file, IGVM_HEADER_SECTION_PLATFORM);
@@ -814,6 +815,13 @@ static int qigvm_supported_platform_compat_mask(QIgvm *ctx, Error **errp)
                         platform->highest_vtl, platform->shared_gpa_boundary)) {
                     compatibility_mask_sev_snp = platform->compatibility_mask;
                 }
+            } else if ((platform->platform_type == IGVM_PLATFORM_TYPE_TDX) &&
+                       ctx->cgs) {
+                if (ctx->cgsc->check_support(
+                        CGS_PLATFORM_TDX, platform->platform_version,
+                        platform->highest_vtl, platform->shared_gpa_boundary)) {
+                    compatibility_mask_tdx = platform->compatibility_mask;
+                }
             } else if (platform->platform_type == IGVM_PLATFORM_TYPE_NATIVE) {
                 compatibility_mask = platform->compatibility_mask;
             }
@@ -821,7 +829,10 @@ static int qigvm_supported_platform_compat_mask(QIgvm *ctx, Error **errp)
         }
     }
     /* Choose the strongest supported isolation technology */
-    if (compatibility_mask_sev_snp != 0) {
+    if (compatibility_mask_tdx != 0) {
+        ctx->compatibility_mask = compatibility_mask_tdx;
+        ctx->platform_type = IGVM_PLATFORM_TYPE_TDX;
+    } else if (compatibility_mask_sev_snp != 0) {
         ctx->compatibility_mask = compatibility_mask_sev_snp;
         ctx->platform_type = IGVM_PLATFORM_TYPE_SEV_SNP;
     } else if (compatibility_mask_sev_es != 0) {
diff --git a/include/system/confidential-guest-support.h b/include/system/confidential-guest-support.h
index 0cc8b26e6..a84fbb74f 100644
--- a/include/system/confidential-guest-support.h
+++ b/include/system/confidential-guest-support.h
@@ -31,6 +31,7 @@ typedef enum ConfidentialGuestPlatformType {
     CGS_PLATFORM_SEV,
     CGS_PLATFORM_SEV_ES,
     CGS_PLATFORM_SEV_SNP,
+    CGS_PLATFORM_TDX,
 } ConfidentialGuestPlatformType;
 
 typedef enum ConfidentialGuestMemoryType {
diff --git a/target/i386/kvm/tdx.c b/target/i386/kvm/tdx.c
index dbf0fa2c9..d2eeb6fe5 100644
--- a/target/i386/kvm/tdx.c
+++ b/target/i386/kvm/tdx.c
@@ -182,8 +182,7 @@ static TdxFirmwareEntry *tdx_get_hob_entry(TdxGuest *tdx)
             return entry;
         }
     }
-    error_report("TDVF metadata doesn't specify TD_HOB location.");
-    exit(1);
+    return NULL;
 }
 
 static void tdx_add_ram_entry(uint64_t address, uint64_t length,
@@ -288,9 +287,11 @@ static void tdx_post_init_vcpus(void)
     TdxFirmwareEntry *hob;
     CPUState *cpu;
 
+    /* An IGVM image has no TD HOB, so its BSP starts with RCX clear. */
     hob = tdx_get_hob_entry(tdx_guest);
     CPU_FOREACH(cpu) {
-        tdx_vcpu_ioctl(cpu, KVM_TDX_INIT_VCPU, 0, (void *)(uintptr_t)hob->address,
+        tdx_vcpu_ioctl(cpu, KVM_TDX_INIT_VCPU, 0,
+                       (void *)(uintptr_t)(hob ? hob->address : 0),
                        &error_fatal);
     }
 }
@@ -306,6 +307,9 @@ static void tdx_finalize_vm(Notifier *notifier, void *unused)
     tdx_init_ram_entries();
 
     for_each_tdx_fw_entry(tdvf, entry) {
+        if (!tdvf->mem_ptr) {
+            break; /* IGVM: entries already point at the loaded guest RAM */
+        }
         switch (entry->type) {
         case TDVF_SECTION_TYPE_BFV:
         case TDVF_SECTION_TYPE_CFV:
@@ -336,7 +340,10 @@ static void tdx_finalize_vm(Notifier *notifier, void *unused)
     qsort(tdx_guest->ram_entries, tdx_guest->nr_ram_entries,
           sizeof(TdxRamEntry), &tdx_ram_entry_compare);
 
-    tdvf_hob_create(tdx_guest, tdx_get_hob_entry(tdx_guest));
+    entry = tdx_get_hob_entry(tdx_guest);
+    if (entry) {
+        tdvf_hob_create(tdx_guest, entry);
+    }
 
     tdx_post_init_vcpus();
 
@@ -373,10 +380,13 @@ static void tdx_finalize_vm(Notifier *notifier, void *unused)
 
     /*
      * TDVF image has been copied into private region above via
-     * KVM_MEMORY_MAPPING. It becomes useless.
+     * KVM_MEMORY_MAPPING. It becomes useless. IGVM images have no such
+     * flash MemoryRegion: their pages were never anywhere else.
      */
-    ram_block = tdx_guest->tdvf_mr->ram_block;
-    ram_block_discard_range(ram_block, 0, ram_block->max_length);
+    if (tdx_guest->tdvf_mr) {
+        ram_block = tdx_guest->tdvf_mr->ram_block;
+        ram_block_discard_range(ram_block, 0, ram_block->max_length);
+    }
 
     tdx_vm_ioctl(KVM_TDX_FINALIZE_VM, 0, NULL, &error_fatal);
     CONFIDENTIAL_GUEST_SUPPORT(tdx_guest)->ready = true;
@@ -1123,7 +1133,62 @@ int tdx_pre_create_vcpu(CPUState *cpu, Error **errp)
 
 int tdx_parse_tdvf(void *flash_ptr, int size)
 {
-    return tdvf_parse_metadata(&tdx_guest->tdvf, flash_ptr, size);
+    int r = tdvf_parse_metadata(&tdx_guest->tdvf, flash_ptr, size);
+
+    /* Only an IGVM image may omit the TD HOB. */
+    if (r == 0 && !tdx_get_hob_entry(tdx_guest)) {
+        error_report("TDVF metadata doesn't specify TD_HOB location.");
+        return -EINVAL;
+    }
+    return r;
+}
+
+/*
+ * An IGVM file states what TDVF metadata states: which pages the TDX module is
+ * handed at launch, and which of them are extended into MRTD.  Each directive
+ * becomes a firmware entry and the existing launch path adds them all.  There
+ * is no VP context to apply -- a TD has an architectural reset state.
+ */
+static bool tdx_cgs_check_support(ConfidentialGuestPlatformType platform,
+                                  uint16_t platform_version,
+                                  uint8_t highest_vtl,
+                                  uint64_t shared_gpa_boundary)
+{
+    return (platform == CGS_PLATFORM_TDX) && (platform_version == 1) &&
+           (highest_vtl == 0) && (shared_gpa_boundary == 0);
+}
+
+static int tdx_cgs_set_guest_state(hwaddr gpa, uint8_t *ptr, uint64_t len,
+                                   ConfidentialGuestPageType memory_type,
+                                   uint16_t cpu_index, Error **errp)
+{
+    TdxFirmware *fw = &tdx_guest->tdvf;
+    uint32_t attributes;
+
+    switch (memory_type) {
+    case CGS_PAGE_TYPE_NORMAL:
+    case CGS_PAGE_TYPE_ZERO:
+        attributes = TDVF_SECTION_ATTRIBUTES_MR_EXTEND;
+        break;
+    case CGS_PAGE_TYPE_UNMEASURED:
+        attributes = 0;
+        break;
+    case CGS_PAGE_TYPE_REQUIRED_MEMORY:
+        return 0; /* carries no data: the TD accepts it itself */
+    default:
+        error_setg(errp, "TDX: unsupported IGVM page type %d", memory_type);
+        return -1;
+    }
+
+    fw->entries = g_renew(TdxFirmwareEntry, fw->entries, fw->nr_entries + 1);
+    fw->entries[fw->nr_entries++] = (TdxFirmwareEntry) {
+        .address = gpa,
+        .size = len,
+        .type = TDVF_SECTION_TYPE_BFV,
+        .attributes = attributes,
+        .mem_ptr = ptr,
+    };
+    return 0;
 }
 
 static void tdx_inject_interrupt(TdxGuest *tdx)
@@ -1541,6 +1606,8 @@ static void tdx_guest_class_init(ObjectClass *oc, const void *data)
     X86ConfidentialGuestClass *x86_klass = X86_CONFIDENTIAL_GUEST_CLASS(oc);
 
     klass->kvm_init = tdx_kvm_init;
+    klass->check_support = tdx_cgs_check_support;
+    klass->set_guest_state = tdx_cgs_set_guest_state;
     x86_klass->kvm_type = tdx_kvm_type;
     x86_klass->cpu_instance_init = tdx_cpu_instance_init;
     x86_klass->adjust_cpuid_features = tdx_adjust_cpuid_features;
-- 
2.55.0

